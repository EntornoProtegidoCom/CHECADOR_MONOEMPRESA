@model ResultadoOperacion?
@if (Model is not null)
{
    var clase = Model.Tipo switch
    {
        TipoResultado.Exito => "success",
        TipoResultado.Advertencia => "warning",
        _ => "danger",
    };
    <div class="alert alert-@clase alert-dismissible fade show" role="@(Model.Tipo == TipoResultado.Exito ? "status" : "alert")">
        @Model.Mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
