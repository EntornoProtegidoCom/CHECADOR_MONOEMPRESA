@page "{id}"
@model ChecadorWeb.Pages.Usuarios.PasswordModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}
<div class="encabezado-pagina">
    <div>
        <h1>Restablecer contraseña</h1>
        @if (Model.Usuario is { } u)
        {
            <p class="subtitulo">@u.Id · @u.NombreCompleto</p>
        }
    </div>
    <a class="btn btn-outline-secondary" asp-page="./Index">Volver</a>
</div>

@if (Model.ErrorCarga is not null)
{
    <partial name="_ErrorCarga" model="Model.ErrorCarga" />
}
else
{
    <form method="post" novalidate class="tarjeta" data-confirmar="¿Restablecer la contraseña? El usuario deberá usar la nueva contraseña y sus sesiones abiertas se cerrarán."
          data-confirmar-boton="Restablecer" data-texto-cargando="Guardando…">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="row g-3">
            <div class="col-md-5">
                <label asp-for="Datos.Nueva" class="form-label"></label>
                <input asp-for="Datos.Nueva" class="form-control" maxlength="50" autocomplete="new-password" aria-describedby="ayudaPwd" />
                <span asp-validation-for="Datos.Nueva" class="text-danger small"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Datos.Confirmar" class="form-label"></label>
                <input asp-for="Datos.Confirmar" class="form-control" maxlength="50" autocomplete="new-password" />
                <span asp-validation-for="Datos.Confirmar" class="text-danger small"></span>
            </div>
        </div>
        <p id="ayudaPwd" class="form-text mt-2">Entre 8 y 50 caracteres, con letras y números. Comunique la contraseña al usuario por un canal seguro.</p>
        <button type="submit" class="btn btn-primary">Restablecer contraseña</button>
    </form>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
